import json
import pandas as pd
from playwright.sync_api import Page, expect

class JsonExcelComparator:
    def __init__(self, page: Page):
        self.page = page
        self.test_data = None  # you’ll set this before comparing

    def compare_json_with_excel(self, rule_excel, json_file, data_excel):
        """
        Compare JSON values with Excel using rule mapping.
        Picks test row based on self.test_data['TestID'] (or similar).
        """

        # --- Load rule + data + JSON ---
        rule_df = pd.read_excel(rule_excel)
        data_df = pd.read_excel(data_excel)

        with open(json_file, "r", encoding="utf-8") as f:
            json_data = json.load(f)

        # --- Identify test row ---
        test_id = self.test_data.get("TestID")  # assume you store test ID in test_data
        first_col = data_df.columns[0]
        row = data_df[data_df[first_col] == test_id].iloc[0]

        # --- JSON path extractor ---
        def get_json_value(data, path):
            parts = path.split(".")
            for p in parts:
                if "[" in p and "]" in p:
                    key, idx = p.split("[")
                    data = data[key][int(idx[:-1])]
                else:
                    data = data[p]
            return data

        # --- Compare JSON and Excel ---
        print(f"\n🔍 Comparing JSON vs Excel for Test ID: {test_id}\n")
        all_pass = True

        for _, rule in rule_df.iterrows():
            json_path = rule["json_field"]
            xls_col = rule["xls_field"]

            json_value = get_json_value(json_data, json_path)
            excel_value = row[xls_col]

            if str(json_value) == str(excel_value):
                print(f"✅ PASS: {json_path} == {xls_col} → {json_value}")
            else:
                print(f"❌ FAIL: {json_path} != {xls_col} → JSON={json_value}, Excel={excel_value}")
                all_pass = False

        print("\nFINAL RESULT:", "PASS ✅" if all_pass else "FAIL ❌")
        return all_pass